# This file is managed by dotmanager.py in developer-hub

# Modular config - sourced from dotfiles/
source ~/dotfiles/dot-shell/env.sh
source ~/dotfiles/dot-shell/aliases.sh
source ~/dotfiles/dot-shell/startup.sh

# Prompt
if [ -n "$BASH_VERSION" ]; then
    source ~/dotfiles/dot-prompts/bash_prompt.sh
else
    source ~/dotfiles/dot-prompts/ash_prompt.sh
fi

# Launch Fish if available
if command -v fish >/dev/null 2>&1 && [ -z "$BASH_EXECUTION_STRING" ]; then
  case "$(ps -o comm= -p $PPID)" in
    fish) ;;  # Already running fish as parent
    *)  ;;
  esac
fi
bind " "\e[Z": backward-word"
bind ""\e[Z": backward-char"
